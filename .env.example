# ============================================================
# StockAI v3.0 Enterprise — Environment Variables Template
# ============================================================
# SECURITY: This file is safe to commit. NEVER commit .env
# ============================================================

# ── 🗄️ Database (REQUIRED for production) ────────────────────
# PostgreSQL connection string (Neon recommended for Vercel)
# Get a free database at: https://neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: Direct URL for migrations (Neon requires this)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── 🔐 Authentication (REQUIRED for production) ───────────────
# JWT signing secret — must be 32+ characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, sessions are lost on every server restart!
JWT_SECRET="your-64-char-hex-secret-here"

# ── AI Providers (add at least one) ──────────────────────────
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GROQ_API_KEY="gsk_..."
XAI_API_KEY="xai-..."
OPENROUTER_API_KEY="sk-or-..."

# ── Enterprise Security ───────────────────────────────────────
# AES-256-GCM encryption for API keys. Generate: openssl rand -hex 32
STOCKAI_KEY_ENCRYPTION_SECRET=""

# ── Google OAuth ──────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ── Application ───────────────────────────────────────────────
APP_URL="http://localhost:3002"
NODE_ENV="development"
DEV_TEST_SECRET="stockai-dev-test-2024"

# ============================================================
# VERCEL REQUIRED ENVIRONMENT VARIABLES:
#   DATABASE_URL     (Neon → Connection Details)
#   DIRECT_URL       (Neon → Connection Details → Direct)
#   JWT_SECRET       (generate with node crypto as above)
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
#   VITE_GOOGLE_CLIENT_ID
#   STOCKAI_KEY_ENCRYPTION_SECRET
#   NODE_ENV=production
# ============================================================
