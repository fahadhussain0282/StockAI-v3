# ============================================================
# StockAI v3.0 Enterprise — Environment Variables Template
# ============================================================
# SECURITY: This file is safe to commit. NEVER commit .env
# ============================================================

# ── AI Providers (add at least one) ─────────────────────────
# All providers support multiple API keys via Admin Dashboard
# ENV keys are auto-seeded as "slot 0" for each provider

# Google Gemini (recommended primary — best vision quality)
# Get key: https://aistudio.google.com/app/apikey
# Key format: AIzaSy... (39 chars)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OpenAI GPT-4o (excellent vision + text)
# Get key: https://platform.openai.com/api-keys
# Key format: sk-... (51+ chars)
OPENAI_API_KEY="sk-..."

# Anthropic Claude (strong reasoning for descriptions)
# Get key: https://console.anthropic.com/settings/keys
# Key format: sk-ant-... (100+ chars)
ANTHROPIC_API_KEY="sk-ant-..."

# Groq (ultra-low latency, free tier available)
# Get key: https://console.groq.com/keys
# Key format: gsk_... (56 chars)
GROQ_API_KEY="gsk_..."

# xAI Grok (alternative vision provider)
# Get key: https://x.ai/api
XAI_API_KEY="xai-..."

# OpenRouter (access 200+ models via unified API)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."

# ── Enterprise Security ──────────────────────────────────────
# Enables AES-256-GCM encryption for all API keys stored in pool
# MUST be exactly 32+ characters. Generate: openssl rand -hex 32
# Without this, keys are stored in plaintext in memory only.
STOCKAI_KEY_ENCRYPTION_SECRET=""

# ── Google OAuth ─────────────────────────────────────────────
# Required for Google Sign-In authentication
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ── Application ──────────────────────────────────────────────
APP_URL="http://localhost:3002"
NODE_ENV="development"

# ── Dev/Testing (development ONLY — never set in production) ─
# Used by stress-test.js to obtain admin tokens for automated testing
# This endpoint is disabled when NODE_ENV=production
DEV_TEST_SECRET="stockai-dev-test-2024"
