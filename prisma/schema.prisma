// StockAI v3.0 Enterprise — Prisma Database Schema
// Database: Supabase PostgreSQL
// ORM: Prisma v7

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  fullName         String
  email            String    @unique
  passwordHash     String?
  googleId         String?   @unique
  avatar           String?
  provider         String    @default("local")
  role             String    @default("contributor")
  status           String    @default("pending_activation")
  activeDeviceId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?
  totalGenerations Int       @default(0)
  totalPrompts     Int       @default(0)
  totalCsvExports  Int       @default(0)

  subscription     Subscription?
  sessions         Session[]
  passwordResets   PasswordResetToken[]
  auditActionsBy   AuditLog[]    @relation("AdminActions")
  auditActionsOn   AuditLog[]    @relation("TargetUser")
  telemetryLogs    TelemetryLog[]
  apiKeys          UserApiKey[]
  providerSettings UserProviderSettings?

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model Subscription {
  id           String   @id @default(cuid())
  userId       String   @unique
  planId       String   @default("plan_free")
  planName     String   @default("Free")
  price        Int      @default(0)
  durationDays Int      @default(0)
  activatedAt  DateTime @default(now())
  expiresAt    DateTime @default(now())
  isActive     Boolean  @default(false)
  isExpired    Boolean  @default(true)
  deviceId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([expiresAt])
}

// ─── Sessions ─────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  isRevoked Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

// ─── Password Reset Tokens ────────────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  adminEmail    String
  action        String
  targetUser    String
  details       String
  adminUserId   String?
  targetUserId  String?
  createdAt     DateTime @default(now())

  admin         User?    @relation("AdminActions", fields: [adminUserId], references: [id], onDelete: SetNull)
  target        User?    @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminEmail])
  @@index([action])
}

// ─── System API Keys (Admin Pool) ─────────────────────────────────────────────

model SystemApiKey {
  id                String   @id @default(cuid())
  provider          String
  label             String
  encryptedKey      String   // AES-256-GCM encrypted or plaintext
  isEnabled         Boolean  @default(true)
  isHealthy         Boolean  @default(true)
  selectionStrategy String   @default("health-based")
  addedAt           DateTime @default(now())
  lastUsedAt        DateTime?
  lastSuccessAt     DateTime?
  lastFailureAt     DateTime?
  successCount      Int      @default(0)
  failureCount      Int      @default(0)
  totalRequests     Int      @default(0)
  avgLatencyMs      Float    @default(0)
  consecutiveFails  Int      @default(0)
  cooldownUntil     BigInt   @default(0)
  rateLimitUntil    BigInt   @default(0)
  quotaStatus       String   @default("ok")
  rateLimitStatus   String   @default("ok")
  timeoutCount      Int      @default(0)
  rateLimitCount    Int      @default(0)
  lastErrorMessage  String?
  healthScore       Int      @default(100)
  source            String   @default("admin")  // "admin" | "env"

  @@index([provider])
  @@index([isEnabled, isHealthy])
  @@index([provider, isEnabled])
}

// ─── AI Telemetry ─────────────────────────────────────────────────────────────

model TelemetryLog {
  id             String   @id @default(cuid())
  requestId      String   @unique @default(cuid())
  userId         String?
  provider       String
  model          String
  responseTimeMs Int      @default(0)
  success        Boolean
  cacheHit       Boolean  @default(false)
  retries        Int      @default(0)
  fallbacks      Int      @default(0)
  errorType      String?
  errorMessage   String?
  platform       String?
  fileName       String?
  fileType       String?
  createdAt      DateTime @default(now())

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([provider])
  @@index([success])
}

// ─── User API Key Pool ────────────────────────────────────────────────────────

model UserApiKey {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  label             String   @default("My API Key")
  encryptedKey      String   // AES-256-GCM encrypted
  maskedKey         String   // E.g. "sk-ant-...****"
  isEnabled         Boolean  @default(true)
  isHealthy         Boolean  @default(true)
  addedAt           DateTime @default(now())
  lastUsedAt        DateTime?
  lastSuccessAt     DateTime?
  lastFailureAt     DateTime?
  successCount      Int      @default(0)
  failureCount      Int      @default(0)
  totalRequests     Int      @default(0)
  avgLatencyMs      Float    @default(0)
  consecutiveFails  Int      @default(0)
  cooldownUntil     BigInt   @default(0)
  rateLimitUntil    BigInt   @default(0)
  quotaStatus       String   @default("ok")
  rateLimitStatus   String   @default("ok")
  timeoutCount      Int      @default(0)
  rateLimitCount    Int      @default(0)
  lastErrorMessage  String?

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([isEnabled, isHealthy])
}

// ─── User Provider Settings ───────────────────────────────────────────────────

model UserProviderSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  fallbackOrder         String   // JSON array of provider IDs e.g. ["google-gemini", "openai"]
  loadBalancingStrategy String   @default("round-robin") // round-robin, least-used, priority, random

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
